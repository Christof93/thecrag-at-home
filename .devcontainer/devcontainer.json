{
  "name": "theCrag at home (Flutter)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "containerEnv": { "FLUTTER_DIR": "/home/vscode/flutter" },
  "postCreateCommand": "bash scripts/setup_cloud_env.sh && /home/vscode/flutter/bin/flutter pub get",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "Flutter web" } },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"]
    }
  },
  "secrets": {
    "THECRAG_API_KEY": { "description": "Personal theCrag API key" }
  }
}
